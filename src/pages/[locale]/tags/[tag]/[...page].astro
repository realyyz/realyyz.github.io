---
import type { GetStaticPathsOptions } from "astro";
import { getCollection } from "astro:content";
import TagPage from "../../../tags/[tag]/[...page].astro";
import { NON_DEFAULT_LOCALES } from "@/i18n/locales";
import { getPostsByLocale } from "@/utils/getPostsByLocale";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return NON_DEFAULT_LOCALES.flatMap(locale => {
    const localePosts = getPostsByLocale(posts, locale);
    const tags = getUniqueTags(localePosts);

    return tags.flatMap(({ tag, tagName }) => {
      const tagPosts = getSortedPosts(
        localePosts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
      );

      return paginate(tagPosts, {
        params: { locale, tag },
        props: { tagName },
        pageSize: config.posts.perPage,
      });
    });
  });
}

const { page, tagName } = Astro.props;
---

<TagPage {page} {tagName} />
